+// Phrase boosting. Each phrase is matched by characters, not one fixed token
+// split: at every offset, any vocabulary piece that continues the phrase
+// (ASCII case-insensitive) may be boosted, however the model segments it.
+struct parakeet_boost_phrase {
+    // steps[offset] = (token, characters consumed) for pieces matching there.
+    std::vector<std::vector<std::pair<int32_t, int32_t>>> steps;
+};
+
+struct parakeet_boost {
+    std::vector<parakeet_boost_phrase> phrases;
+    float score = 0.0f;
+    // Share of the bonus for starting a phrase. Starts can replace a common
+    // word with a phrase's first piece, so they get a small share and only
+    // for starts of start_min_letters or more.
+    float start_fraction = 0.3f;
+    // Starts shorter than this many letters ("co", "sup") are never boosted:
+    // they begin too many ordinary words.
+    int32_t start_min_letters = 3;
+    // A one-letter start ("C" of "Claude") begins far too many words to track
+    // as the start of a phrase, even when the model chose it.
+    int32_t match_min_letters = 2;
+    bool empty() const { return phrases.empty() || score <= 0.0f; }
+};
+
+// A partial match: phrase index and characters matched so far.
+using parakeet_boost_match = std::pair<int32_t, int32_t>;
+
 struct parakeet_context {
