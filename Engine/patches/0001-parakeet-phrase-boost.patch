+static std::string parakeet_ascii_lower(std::string text) {
+    for (auto & c : text) c = (char) std::tolower((unsigned char) c);
+    return text;
+}
+
+int parakeet_set_boost_phrases(struct parakeet_context * ctx, const char ** phrases, int n_phrases, float score) {
+    parakeet_boost boost;
+    boost.score = score;
+    if (const char * fraction = getenv("INLAY_PHRASE_BOOST_START")) boost.start_fraction = strtof(fraction, nullptr);
+    if (const char * letters = getenv("INLAY_PHRASE_BOOST_START_MIN")) boost.start_min_letters = atoi(letters);
+    if (n_phrases <= 0 || score <= 0.0f) {
+        ctx->boost = std::move(boost);
+        return 0;
+    }
+    // Lowercased piece text -> token ids, built once per call.
+    std::unordered_map<std::string, std::vector<int32_t>> pieces;
+    size_t max_length = 0;
+    for (const auto & entry : ctx->vocab.token_to_id) {
+        if (entry.second == ctx->vocab.token_blank || is_sentencepiece_control(entry.first)) continue;
+        pieces[parakeet_ascii_lower(entry.first)].push_back(entry.second);
+        max_length = std::max(max_length, entry.first.size());
+    }
+    for (int i = 0; i < n_phrases; ++i) {
+        if (!phrases[i] || !phrases[i][0]) continue;
+        // The normalizer adds the word-start marker, as for spoken words.
+        const std::string target = parakeet_ascii_lower(sentencepiece_normalize(phrases[i]));
+        parakeet_boost_phrase phrase;
+        phrase.steps.resize(target.size());
+        for (size_t offset = 0; offset < target.size(); ++offset) {
+            for (size_t length = 1; length <= max_length && offset + length <= target.size(); ++length) {
+                const auto it = pieces.find(target.substr(offset, length));
+                if (it == pieces.end()) continue;
+                for (const auto id : it->second) phrase.steps[offset].emplace_back(id, (int32_t) length);
+            }
+        }
+        if (phrase.steps[0].empty()) continue;
+        boost.phrases.push_back(std::move(phrase));
+    }
+    const int added = (int) boost.phrases.size();
+    ctx->boost = std::move(boost);
+    return added;
+}
+
 int parakeet_token_count(struct parakeet_context * ctx, const char * text) {
     return -parakeet_tokenize(ctx, text, NULL, 0);
 }
